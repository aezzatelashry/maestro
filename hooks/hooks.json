{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/scripts/hooks/session_start.py\" || python \"${CLAUDE_PLUGIN_ROOT}/scripts/hooks/session_start.py\"",
            "timeout": 10
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/scripts/hooks/subagent_stop.py\" || python \"${CLAUDE_PLUGIN_ROOT}/scripts/hooks/subagent_stop.py\"",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/scripts/hooks/stop_nudge.py\" || python \"${CLAUDE_PLUGIN_ROOT}/scripts/hooks/stop_nudge.py\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
